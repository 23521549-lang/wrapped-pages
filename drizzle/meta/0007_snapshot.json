          "name": "media_bytes",
          "value": "\"media\".\"bytes\" between 1 and (case when \"media\".\"kind\" = 'ghi-am' then 2097152 else 1048576 end)"
        },
        "media_anh": {
          "name": "media_anh",
          "value": "\"media\".\"kind\" = 'ghi-am' or (\"media\".\"mime\" in ('image/webp', 'image/jpeg') and \"media\".\"width\" is not null and \"media\".\"height\" is not null and \"media\".\"width\" between 1 and 1200 and \"media\".\"height\" between 1 and 1600 and \"media\".\"duration_ms\" is null and \"media\".\"peaks\" is null)"
