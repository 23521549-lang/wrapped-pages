        "media_bia": {
          "name": "media_bia",
          "value": "\"media\".\"kind\" <> 'bia' or \"media\".\"width\" * 3 = \"media\".\"height\" * 5"
        },
        "media_ghi_am": {
          "name": "media_ghi_am",
          "value": "\"media\".\"kind\" <> 'ghi-am' or (\"media\".\"mime\" in ('audio/webm', 'audio/mp4') and \"media\".\"width\" is null and \"media\".\"height\" is null and \"media\".\"duration_ms\" is not null and \"media\".\"duration_ms\" between 1 and 180000 and \"media\".\"peaks\" is not null and case when jsonb_typeof(\"media\".\"peaks\") = 'array' then jsonb_array_length(\"media\".\"peaks\") = 48 and not jsonb_path_exists(\"media\".\"peaks\", '$[*] ? (@.type() != \"number\" || @ < 0 || @ > 100 || @.floor() != @)') else false end)"
        },
        "media_store_key": {
          "name": "media_store_key",
          "value": "\"media\".\"store_key\" ~ '^(cho|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})[/][0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}[.](webp|jpg|webm|m4a)$'"
        }
      },
      "isRLSEnabled": false
    },
