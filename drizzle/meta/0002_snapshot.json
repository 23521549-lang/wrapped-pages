      "checkConstraints": {
        "seals_kind": {
          "name": "seals_kind",
          "value": "\"seals\".\"kind\" in ('cau-do', 'hen-gio', 'trao-doi')"
        },
        "seals_range": {
          "name": "seals_range",
          "value": "\"seals\".\"first_position\" >= 1 and \"seals\".\"last_position\" >= \"seals\".\"first_position\""
        },
        "seals_hen_gio": {
          "name": "seals_hen_gio",
          "value": "\"seals\".\"kind\" <> 'hen-gio' or (\"seals\".\"opens_at\" is not null and \"seals\".\"question\" is null and \"seals\".\"opened_at\" is null and \"seals\".\"gift_note\" is null)"
        },
        "seals_thu_thach": {
          "name": "seals_thu_thach",
          "value": "\"seals\".\"kind\" = 'hen-gio' or (\"seals\".\"question\" is not null and \"seals\".\"opens_at\" is null)"
        },
        "seals_dap_an": {
          "name": "seals_dap_an",
          "value": "(\"seals\".\"kind\" = 'cau-do' and jsonb_array_length(\"seals\".\"answers\") between 1 and 5) or (\"seals\".\"kind\" <> 'cau-do' and jsonb_array_length(\"seals\".\"answers\") = 0)"
        },
        "seals_goi_y": {
          "name": "seals_goi_y",
          "value": "jsonb_array_length(\"seals\".\"hints\") <= 3 and (\"seals\".\"kind\" = 'cau-do' or jsonb_array_length(\"seals\".\"hints\") = 0)"
        },
        "seals_cau_hoi": {
          "name": "seals_cau_hoi",
          "value": "\"seals\".\"question\" is null or char_length(\"seals\".\"question\") between 1 and 200"
        },
        "seals_loi_nhan": {
          "name": "seals_loi_nhan",
          "value": "\"seals\".\"gift_note\" is null or char_length(\"seals\".\"gift_note\") <= 200"
        },
        "seals_he_lo": {
          "name": "seals_he_lo",
          "value": "char_length(\"seals\".\"teaser\") <= 81"
        }
      },
      "isRLSEnabled": false
    },
